<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:o="using:Weekmark.App.Onboarding"
        x:Class="Weekmark.App.Onboarding.WelcomeWindow"
        x:DataType="o:WelcomeViewModel"
        Title="Welcome to Weekmark"
        Icon="avares://Weekmark/Assets/weekmark.ico"
        Width="480" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="28,24" Spacing="12">
    <TextBlock Text="{Binding WeekTitle}" FontSize="40" FontWeight="Bold" Foreground="{DynamicResource SystemAccentColor}"
               HorizontalAlignment="Center" />
    <TextBlock Text="{Binding WeekRange}" FontSize="16" HorizontalAlignment="Center" Margin="0,-8,0,4" />
    <TextBlock TextWrapping="Wrap" Opacity="0.7" TextAlignment="Center"
               Text="Weekmark keeps the current week on your desktop and in the tray." />

    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto" Margin="0,8,0,0">
      <TextBlock Text="Week numbering" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Static o:WelcomeViewModel.Numberings}"
                SelectedIndex="{Binding NumberingIndex}" />
      <TextBlock Grid.Row="1" Text="Public holidays" VerticalAlignment="Center" Margin="0,10,0,0" />
      <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,10,0,0"
                ItemsSource="{x:Static o:WelcomeViewModel.Regions}" SelectedIndex="{Binding RegionIndex}" />
      <TextBlock Grid.Row="2" Text="Quick Finder hotkey" VerticalAlignment="Center" Margin="0,10,0,0" />
      <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,10,0,0"
                ItemsSource="{x:Static o:WelcomeViewModel.Hotkeys}" SelectedIndex="{Binding HotkeyIndex}" />
    </Grid>
    <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.7"
               Text="Holidays are used for working-day counts. You can add more countries, your company's holiday calendar, sprints and milestones later in Settings." />

    <Border Background="#1A808080" CornerRadius="6" Padding="12,10">
      <TextBlock TextWrapping="Wrap"
                 Text="Windows may hide new tray icons: drag Weekmark from the ^ overflow onto the taskbar to keep the week number visible." />
    </Border>

    <CheckBox Content="Start Weekmark with Windows" IsChecked="{Binding StartWithWindows}" />
    <Button Content="Done" Classes="accent" IsDefault="True" HorizontalAlignment="Right" MinWidth="90"
            HorizontalContentAlignment="Center" Click="Done" />
  </StackPanel>
</Window>
