<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:f="using:Weekmark.App.Finder"
        xmlns:c="using:Weekmark.Core"
        x:Class="Weekmark.App.Finder.QuickFinderWindow"
        x:DataType="f:QuickFinderViewModel"
        Title="Quick Finder"
        Width="640" SizeToContent="Height" CanResize="False"
        SystemDecorations="None" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        Background="{DynamicResource PanelSolid}"
        FontFamily="Segoe UI Variable Text, Segoe UI, $Default">
  <Window.Styles>
    <StyleInclude Source="avares://Weekmark/Widget/WidgetTheme.axaml" />
    <!-- Rows are never focused: a click selects and the keyboard stays in the field. -->
    <Style Selector="ListBoxItem">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter, ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CurrentRow}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover:not(:selected) /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Fill07}" />
    </Style>
    <Style Selector="ListBoxItem:not(:selected) TextBlock.entercopy">
      <Setter Property="Opacity" Value="0" />
    </Style>
  </Window.Styles>

  <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="8">
    <StackPanel>
      <Grid ColumnDefinitions="*,Auto" Margin="18,16">
        <TextBox Name="Field" Text="{Binding Query}" Watermark="{x:Static f:QuickFinderViewModel.Placeholder}"
                 FontSize="22" FontWeight="Medium" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center" />
        <Border Grid.Column="1" Margin="12,0,0,0" Padding="8,4" CornerRadius="12" Background="{DynamicResource CurrentRow}" VerticalAlignment="Center">
          <TextBlock Text="{Binding Badge}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
        </Border>
      </Grid>
      <Border Height="1" Background="{DynamicResource Divider}" />
      <ListBox Name="Rows" Background="Transparent" Padding="8" Focusable="False">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="c:QueryResult">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Panel Width="30" Height="30" VerticalAlignment="Top">
                <Border CornerRadius="8" Opacity="0.14" Background="{Binding Kind, Converter={x:Static f:QuickFinderWindow.KindColor}}" />
                <TextBlock Text="{Binding Kind, Converter={x:Static f:QuickFinderWindow.KindGlyph}}" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{Binding Kind, Converter={x:Static f:QuickFinderWindow.KindColor}}" />
              </Panel>
              <StackPanel Grid.Column="1" Margin="12,0,8,0" Spacing="2">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Classes="secondary" FontSize="12" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detail}" Classes="tertiary" FontSize="11" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
              <TextBlock Grid.Column="2" Classes="secondary entercopy" Text="Enter Copy" FontSize="10" FontWeight="SemiBold" Margin="0,8,0,0" VerticalAlignment="Top"
                         IsVisible="{Binding CopyText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Height="1" Background="{DynamicResource Divider}" />
      <StackPanel Orientation="Horizontal" Spacing="14" Margin="18,9" TextElement.FontSize="11" TextElement.FontWeight="Medium">
        <TextBlock Text="{Binding Copied, StringFormat='✓ Copied “{0}”'}" Foreground="#34C759"
                   IsVisible="{Binding Copied, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel Orientation="Horizontal" Spacing="14" IsVisible="{Binding Copied, Converter={x:Static ObjectConverters.IsNull}}">
          <TextBlock Classes="secondary" Text="Enter Copy" />
          <TextBlock Classes="secondary" Text="Ctrl+Enter Show in widget" />
          <TextBlock Classes="secondary" Text="↑↓ Select" />
          <TextBlock Classes="secondary" Text="Esc Close" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
