<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="using:Weekmark.App.Widget"
             x:Class="Weekmark.App.Widget.MonthGrid"
             x:DataType="w:WidgetViewModel"
             Background="Transparent">
  <!-- Theme and styles come from WidgetTheme. Scroll or ‹ › changes month; hover/click a week. -->
  <StackPanel Spacing="3">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
      <TextBlock Text="{Binding MonthTitle}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
        <Button Classes="pill" Content="Today" Command="{Binding ResetCommand}" IsVisible="{Binding IsBrowsing}" />
        <Button Classes="pill square" Command="{Binding ShowYearCommand}" AutomationProperties.Name="Year at a Glance"
                ToolTip.Tip="Year at a Glance">
          <Path Data="{DynamicResource CalendarIcon}" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.2"
                StrokeLineCap="Round" StrokeJoin="Round" Width="10" Height="10" Stretch="Uniform" />
        </Button>
        <Button Classes="pill square" Command="{Binding PreviousCommand}" AutomationProperties.Name="Previous month">
          <Path Data="{DynamicResource ChevronLeft}" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6"
                StrokeLineCap="Round" StrokeJoin="Round" Width="5" Height="9" Stretch="Uniform" />
        </Button>
        <Button Classes="pill square" Command="{Binding NextCommand}" AutomationProperties.Name="Next month">
          <Path Data="{DynamicResource ChevronRight}" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6"
                StrokeLineCap="Round" StrokeJoin="Round" Width="5" Height="9" Stretch="Uniform" />
        </Button>
      </StackPanel>
    </Grid>

    <DockPanel>
      <TextBlock DockPanel.Dock="Left" Width="30" Text="CW" TextAlignment="Center" Classes="tertiary" FontSize="9" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding Weekdays}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="7" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{Binding}" TextAlignment="Center" Classes="tertiary" FontSize="9" FontWeight="SemiBold" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DockPanel>

    <w:WeekRows Rows="{Binding Rows}" />
  </StackPanel>
</UserControl>
