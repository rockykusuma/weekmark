<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="using:Weekmark.App.Widget"
             x:Class="Weekmark.App.Widget.WidgetView"
             x:DataType="w:WidgetViewModel"
             FontFamily="Segoe UI Variable Text, Segoe UI, $Default">

  <!-- Sizes are the Mac's points at Medium; the whole card is scaled by the size setting (LayoutTransform). -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Accent" Color="#007AFF" />
          <SolidColorBrush x:Key="Holiday" Color="#FF3B30" />
          <SolidColorBrush x:Key="PinnedColor" Color="#FF9500" />
          <SolidColorBrush x:Key="TextPrimary" Color="#D9000000" />
          <SolidColorBrush x:Key="TextSecondary" Color="#80000000" />
          <SolidColorBrush x:Key="TextWeekend" Color="#59000000" />
          <SolidColorBrush x:Key="TextTertiary" Color="#47000000" />
          <SolidColorBrush x:Key="TextQuaternary" Color="#2E000000" />
          <SolidColorBrush x:Key="Track" Color="#1F000000" />
          <SolidColorBrush x:Key="Fill08" Color="#14000000" />
          <SolidColorBrush x:Key="Fill07" Color="#12000000" />
          <SolidColorBrush x:Key="Divider" Color="#1A000000" />
          <SolidColorBrush x:Key="PillHover" Color="#24000000" />
          <SolidColorBrush x:Key="PillPressed" Color="#2E000000" />
          <SolidColorBrush x:Key="PanelSolid" Color="#F3F3F3" />
          <SolidColorBrush x:Key="PanelGlass" Color="#59F3F3F3" />
          <SolidColorBrush x:Key="BarGap" Color="#99F3F3F3" />
          <SolidColorBrush x:Key="CurrentRow" Color="#24007AFF" />
          <SolidColorBrush x:Key="SprintLine" Color="#73007AFF" />
          <SolidColorBrush x:Key="PinnedRow" Color="#33FF9500" />
          <SolidColorBrush x:Key="PinnedRowStroke" Color="#D9FF9500" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Accent" Color="#0A84FF" />
          <SolidColorBrush x:Key="Holiday" Color="#FF453A" />
          <SolidColorBrush x:Key="PinnedColor" Color="#FF9F0A" />
          <SolidColorBrush x:Key="TextPrimary" Color="#E6FFFFFF" />
          <SolidColorBrush x:Key="TextSecondary" Color="#8CFFFFFF" />
          <SolidColorBrush x:Key="TextWeekend" Color="#62FFFFFF" />
          <SolidColorBrush x:Key="TextTertiary" Color="#47FFFFFF" />
          <SolidColorBrush x:Key="TextQuaternary" Color="#29FFFFFF" />
          <SolidColorBrush x:Key="Track" Color="#1FFFFFFF" />
          <SolidColorBrush x:Key="Fill08" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="Fill07" Color="#12FFFFFF" />
          <SolidColorBrush x:Key="Divider" Color="#1AFFFFFF" />
          <SolidColorBrush x:Key="PillHover" Color="#24FFFFFF" />
          <SolidColorBrush x:Key="PillPressed" Color="#2EFFFFFF" />
          <SolidColorBrush x:Key="PanelSolid" Color="#202020" />
          <SolidColorBrush x:Key="PanelGlass" Color="#59202020" />
          <SolidColorBrush x:Key="BarGap" Color="#99202020" />
          <SolidColorBrush x:Key="CurrentRow" Color="#240A84FF" />
          <SolidColorBrush x:Key="SprintLine" Color="#730A84FF" />
          <SolidColorBrush x:Key="PinnedRow" Color="#33FF9F0A" />
          <SolidColorBrush x:Key="PinnedRowStroke" Color="#D9FF9F0A" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <StreamGeometry x:Key="FlagIcon">M0,0 H1.4 V10 H0 Z M1.4,0.6 H8.6 L6.9,3.3 L8.6,6 H1.4 Z</StreamGeometry>
      <StreamGeometry x:Key="ChevronLeft">M4.5,0.5 L0.5,4.5 L4.5,8.5</StreamGeometry>
      <StreamGeometry x:Key="ChevronRight">M0.5,0.5 L4.5,4.5 L0.5,8.5</StreamGeometry>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.tertiary">
      <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
    </Style>

    <!-- Card backgrounds -->
    <Style Selector="Panel#Root">
      <Setter Property="Margin" Value="12" />
    </Style>
    <Style Selector="Panel#Root.glass">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Border#Card">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="24" />
    </Style>
    <Style Selector="Panel#Root.solid Border#Card">
      <Setter Property="Background" Value="{DynamicResource PanelSolid}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Fill08}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 3 10 0 #40000000" />
    </Style>
    <Style Selector="Panel#Root.glass Border#Card">
      <Setter Property="Background" Value="{DynamicResource PanelGlass}" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Panel#Root.clear StackPanel#Body">
      <Setter Property="Effect">
        <DropShadowEffect OffsetX="0" OffsetY="1" BlurRadius="5" Color="#80000000" />
      </Setter>
    </Style>

    <!-- 7-day strip -->
    <Style Selector="TextBlock.weekday">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.weekday.weekend">
      <Setter Property="Foreground" Value="{DynamicResource TextWeekend}" />
    </Style>
    <Style Selector="TextBlock.weekday.today">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="TextBlock.daynum.past">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.daynum.holiday">
      <Setter Property="Foreground" Value="{DynamicResource Holiday}" />
    </Style>
    <Style Selector="TextBlock.daynum.out">
      <Setter Property="Foreground" Value="{DynamicResource TextQuaternary}" />
    </Style>
    <Style Selector="TextBlock.daynum.today">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Month rows: pinned (orange) > current week > hover -->
    <Style Selector="TextBlock.week">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.week.milestone" x:DataType="w:MonthRowModel">
      <Setter Property="Foreground" Value="{Binding Flag}" />
    </Style>
    <Style Selector="Panel.row.current TextBlock.week">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Panel.row.pinned TextBlock.week">
      <Setter Property="Foreground" Value="{DynamicResource PinnedColor}" />
    </Style>
    <Style Selector="Panel.row.hover > Border.rowbg">
      <Setter Property="Background" Value="{DynamicResource Fill07}" />
    </Style>
    <Style Selector="Panel.row.current > Border.rowbg">
      <Setter Property="Background" Value="{DynamicResource CurrentRow}" />
    </Style>
    <Style Selector="Panel.row.pinned > Border.rowbg">
      <Setter Property="Background" Value="{DynamicResource PinnedRow}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PinnedRowStroke}" />
      <Setter Property="BorderThickness" Value="1.2" />
    </Style>

    <!-- Details line -->
    <Style Selector="TextBlock.details.current">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="TextBlock.details.pinned">
      <Setter Property="Foreground" Value="{DynamicResource PinnedColor}" />
    </Style>

    <!-- Pill buttons (Today, ‹ ›) -->
    <Style Selector="Button.pill">
      <Setter Property="Background" Value="{DynamicResource Fill08}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.pill.square">
      <Setter Property="Width" Value="20" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PillHover}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.pill:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PillPressed}" />
    </Style>
  </UserControl.Styles>

  <Panel x:Name="Root" Classes.glass="{Binding IsGlass}" Classes.solid="{Binding IsSolid}" Classes.clear="{Binding IsClear}">
    <LayoutTransformControl x:Name="Scaler">
      <Border x:Name="Card" Width="300" Padding="18">
        <StackPanel x:Name="Body" Spacing="14">

          <!-- Header: big week number + year ring -->
          <Grid ColumnDefinitions="*,Auto" AutomationProperties.Name="{Binding Header.Description}">
            <StackPanel>
              <TextBlock Text="CALENDAR WEEK" Classes="secondary" FontSize="11" FontWeight="SemiBold" LetterSpacing="1.6" />
              <TextBlock Text="{Binding Header.Week}" Foreground="{DynamicResource Accent}" FontSize="78" FontWeight="Bold"
                         FontFamily="Segoe UI Variable Display, Segoe UI, $Default" Margin="0,-4,0,-8" />
              <TextBlock Text="{Binding Header.Range}" Classes="secondary" FontSize="14" FontWeight="Medium" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
              <TextBlock Text="{Binding Header.Year}" Classes="secondary" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
              <Panel Width="50" Height="50" HorizontalAlignment="Right">
                <Ellipse Stroke="{DynamicResource Track}" StrokeThickness="5" />
                <Arc StartAngle="-90" SweepAngle="{Binding Header.YearSweep}" Stroke="{DynamicResource Accent}"
                     StrokeThickness="5" StrokeLineCap="Round" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="-2">
                  <TextBlock Text="{Binding Header.Week}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding Header.OfWeeks}" Classes="secondary" FontSize="8" FontWeight="Medium" HorizontalAlignment="Center" />
                </StackPanel>
              </Panel>
              <TextBlock Text="{Binding Header.WeeksLeft}" Classes="secondary" FontSize="10" FontWeight="Medium" HorizontalAlignment="Right" />
            </StackPanel>
          </Grid>

          <!-- Planning chips: quarter, sprint, PI (shrink to fit like the Mac's minimumScaleFactor) -->
          <Viewbox IsVisible="{Binding ShowPlanning}" StretchDirection="DownOnly" HorizontalAlignment="Left">
            <ItemsControl ItemsSource="{Binding Chips}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="w:ChipModel">
                  <Border Background="{DynamicResource Fill08}" CornerRadius="10" Padding="7,3.5" ToolTip.Tip="{Binding Tip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Path Data="{Binding Icon}" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.3"
                            StrokeLineCap="Round" StrokeJoin="Round" Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Text}" Classes="secondary" FontSize="10.5" FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Viewbox>

          <!-- 7-day strip -->
          <ItemsControl ItemsSource="{Binding Days}" Margin="0,0,0,-6">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="7" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="w:DayModel">
                <StackPanel Spacing="5" Background="Transparent" ToolTip.Tip="{Binding Tip}">
                  <TextBlock Text="{Binding Weekday}" Classes="weekday" Classes.weekend="{Binding IsWeekend}" Classes.today="{Binding IsToday}"
                             FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <Panel Width="30" Height="30">
                    <Ellipse Fill="{DynamicResource Accent}" IsVisible="{Binding IsToday}" />
                    <TextBlock Text="{Binding Number}" Classes="daynum" Classes.past="{Binding IsPast}" Classes.holiday="{Binding IsHoliday}"
                               Classes.today="{Binding IsToday}" FontSize="15" FontWeight="Medium"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Panel>
                  <Panel Width="4" Height="4">
                    <Ellipse Fill="{DynamicResource Holiday}" IsVisible="{Binding IsHoliday}" />
                  </Panel>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Week progress -->
          <StackPanel Spacing="6" IsVisible="{Binding ShowProgress}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Progress.Today}" Classes="secondary" FontSize="11" FontWeight="Medium" />
              <TextBlock Grid.Column="1" Text="{Binding Progress.Percent}" Classes="secondary" FontSize="11" FontWeight="Medium" />
            </Grid>
            <Border Height="5" CornerRadius="2.5" ClipToBounds="True" Background="{DynamicResource Track}">
              <Panel>
                <Border Width="{Binding Progress.FillWidth}" HorizontalAlignment="Left" Background="{DynamicResource Accent}" CornerRadius="2.5" />
                <UniformGrid Columns="7">
                  <Border />
                  <Border BorderBrush="{DynamicResource BarGap}" BorderThickness="1,0,0,0" />
                  <Border BorderBrush="{DynamicResource BarGap}" BorderThickness="1,0,0,0" />
                  <Border BorderBrush="{DynamicResource BarGap}" BorderThickness="1,0,0,0" />
                  <Border BorderBrush="{DynamicResource BarGap}" BorderThickness="1,0,0,0" />
                  <Border BorderBrush="{DynamicResource BarGap}" BorderThickness="1,0,0,0" />
                  <Border BorderBrush="{DynamicResource BarGap}" BorderThickness="1,0,0,0" />
                </UniformGrid>
              </Panel>
            </Border>
          </StackPanel>

          <!-- Up to 3 upcoming milestones; click pins the week -->
          <ItemsControl ItemsSource="{Binding Milestones}" IsVisible="{Binding ShowMilestones}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="5" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="w:MilestoneModel">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Background="Transparent" ToolTip.Tip="{Binding Tip}"
                      PointerPressed="OnMilestonePressed">
                  <Path Data="{DynamicResource FlagIcon}" Fill="{Binding Brush}" Width="9" Height="9" Stretch="Uniform"
                        VerticalAlignment="Center" Margin="0,0,7,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding WeekText}" Foreground="{Binding Brush}" FontSize="11" FontWeight="Bold"
                             VerticalAlignment="Center" Margin="4,0,0,0" />
                  <TextBlock Grid.Column="3" Text="{Binding Countdown}" IsVisible="{Binding Countdown, Converter={x:Static ObjectConverters.IsNotNull}}"
                             Classes="secondary" FontSize="10.5" FontWeight="Medium" VerticalAlignment="Center" Margin="7,0,0,0" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Rectangle Height="1" Fill="{DynamicResource Divider}" />

          <w:MonthGrid IsVisible="{Binding ShowMonth}" />

          <!-- Details of the hovered or pinned week (the Mac's finder result line) -->
          <StackPanel Height="32" Spacing="2">
            <TextBlock Text="{Binding Details.Title}" IsVisible="{Binding !Details.IsHint}" Classes="details"
                       Classes.current="{Binding Details.IsCurrent}" Classes.pinned="{Binding Details.IsPinned}"
                       FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Details.Subtitle}" Classes="secondary" Classes.tertiary="{Binding Details.IsHint}"
                       FontSize="10.5" TextTrimming="CharacterEllipsis" />
          </StackPanel>

        </StackPanel>
      </Border>
    </LayoutTransformControl>
  </Panel>
</UserControl>
