# ─────────────────────────────────────────────────────────────────────────────
# Weekmark release credentials
#
#   cp .env.local.example .env.local      # then fill in your values
#
# .env.local is git-ignored and read automatically by scripts/release.sh.
# Only needed to publish a signed release. ./build.sh works without any of this.
# ─────────────────────────────────────────────────────────────────────────────


# ── 1. Apple Developer ID (required) ─────────────────────────────────────────
# Comes with the Apple Developer Program ($99/yr): https://developer.apple.com/programs/
# Create the certificate in Xcode → Settings → Accounts → Manage Certificates → "+" →
# "Developer ID Application". Then list what's in your keychain:
#   security find-identity -v -p codesigning
# Copy the full quoted name exactly as printed.
DEV_ID="Developer ID Application: Rakesh Kusuma (ABCDE12345)"

# Your 10-character Team ID: the part in brackets above, also shown at
# https://developer.apple.com/account → Membership details.
TEAM_ID="ABCDE12345"

# Optional: builds a signed .pkg for Intune/Jamf/Kandji. Create a
# "Developer ID Installer" certificate the same way. Leave empty to skip the .pkg.
INSTALLER_ID=""
# INSTALLER_ID="Developer ID Installer: Rakesh Kusuma (ABCDE12345)"


# ── 2. Notarization (required) ───────────────────────────────────────────────
# Recommended: store the credentials in your keychain once and reference them by name.
#   xcrun notarytool store-credentials weekmark-notary \
#       --apple-id "you@example.com" --team-id "ABCDE12345" --password "abcd-efgh-ijkl-mnop"
# The password is an app-specific password from https://account.apple.com → Sign-In and
# Security → App-Specific Passwords. It is not your Apple ID password.
NOTARY_PROFILE="weekmark-notary"

# Alternative, e.g. on a CI machine without a keychain profile: leave NOTARY_PROFILE empty
# and set these three instead.
APPLE_ID=""                 # you@example.com
APP_SPECIFIC_PASSWORD=""    # abcd-efgh-ijkl-mnop


# ── 3. Sparkle auto-updates (already set up on this Mac) ─────────────────────
# The EdDSA private key that signs updates lives in your login keychain under this
# account. The matching public key is SUPublicEDKey in Resources/Info.plist and isn't secret.
# Back the private key up once (and never commit it):
#   .build/artifacts/sparkle/Sparkle/bin/generate_keys --account weekmark -x weekmark-sparkle.key
SPARKLE_ACCOUNT="weekmark"

# Alternative for a machine without that keychain item (e.g. CI): path to the exported key file.
# When set, it is used instead of SPARKLE_ACCOUNT.
SPARKLE_KEY_FILE=""


# ── 4. Where releases are published ──────────────────────────────────────────
# Used to build the download URLs written into docs/appcast.xml.
GITHUB_REPO="rockykusuma/weekmark"


# ─────────────────────────────────────────────────────────────────────────────
# Not needed today. If you later automate releases in GitHub Actions, add these as
# repository secrets (Settings → Secrets and variables → Actions):
#
#   MACOS_CERT_P12_BASE64    base64 of your Developer ID Application cert exported as .p12
#                            (Keychain Access → right-click cert → Export) → base64 -i cert.p12
#   MACOS_CERT_PASSWORD      password you chose when exporting the .p12
#   KEYCHAIN_PASSWORD        any random string; used for a temporary CI keychain
#   DEV_ID, TEAM_ID          same values as above
#   APPLE_ID, APP_SPECIFIC_PASSWORD   for notarytool on CI
#   SPARKLE_PRIVATE_KEY      contents of weekmark-sparkle.key
# ─────────────────────────────────────────────────────────────────────────────
